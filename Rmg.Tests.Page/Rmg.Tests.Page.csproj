<Project Sdk="Microsoft.NET.Sdk">

    <!--
        The page driven in a browser, apart from the other tests: it starts the server and a headless Chromium, and
        takes half a minute, so it is run when the page changes rather than with every build.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
      <PackageReference Include="TUnit" Version="1.68.17" />
    </ItemGroup>

    <ItemGroup>
      <!-- built first, and started as it is published, rather than referenced -->
      <ProjectReference Include="..\Rmg.WebApi\Rmg.WebApi.csproj" ReferenceOutputAssembly="false" />
    </ItemGroup>

    <!--
        the listening mode's questions as the tests ask them, served in place of the page's own, which lose questions as
        they are answered: one patching a genre, copies of it for the tests that give verdicts, and one leaving out a stage
    -->
    <ItemGroup>
      <None Include="listening.json" CopyToOutputDirectory="PreserveNewest" />
      <!-- the browser's fonts, the same on every machine (Site.Fonts) -->
      <None Include="fonts.conf" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- a collection compared in its order, or as a set where it says so -->
    <ItemGroup>
      <Using Include="TUnit.Assertions.Enums" />
    </ItemGroup>

</Project>
