<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <InvariantGlobalization>true</InvariantGlobalization>
        <!-- Caddy compresses on the way out, and UseStaticFiles would never serve a .br or .gz of its own -->
        <CompressionEnabled>false</CompressionEnabled>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Rmg.Core\Rmg.Core.csproj" />
    </ItemGroup>

    <ItemGroup>
      <!-- whatever is in the soundfont directory is the operator's, not the build's: it is theirs to put
           on a server under its own licence, and a publish would otherwise carry tens of megabytes of it -->
      <Content Remove="wwwroot\soundfonts\**" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    </ItemGroup>

    <!-- the page's JS and CSS, bundled from Client/ into wwwroot on every build -->
    <Import Project="Client.targets" />

</Project>
