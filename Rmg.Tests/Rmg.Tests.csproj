<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>14</LangVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!-- the corpus's songs are generated in parallel, and allocate a lot: server GC keeps the cores busy -->
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <!-- a test run is too short for profile-guided optimisation to pay for its instrumentation: songs made 1.6 times faster without -->
        <TieredPGO>false</TieredPGO>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="TUnit" Version="1.68.17" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Rmg.Core\Rmg.Core.csproj" />
      <ProjectReference Include="..\Rmg\Rmg.csproj" />
      <ProjectReference Include="..\Rmg.WebApi\Rmg.WebApi.csproj" />
    </ItemGroup>

</Project>
