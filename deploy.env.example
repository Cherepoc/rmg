# Copy to deploy.env and fill in. deploy.env is git-ignored, because it names your server.
#
# The RMG_* settings below are written to /etc/<service>/<service>.env on the VPS, where they
# override appsettings.json. That file ships with the app and holds the defaults, so anything the
# same on every machine belongs there, in the repository, and only what differs belongs here.
# Leave one out and appsettings.json decides.

# Where to deploy: an alias from ~/.ssh/config, or user@host. Key auth, no password.
RMG_HOST=rmg@vps.example.com

# Where the app goes on the VPS, and what the service and its account are called.
RMG_PATH=/opt/rmg
RMG_SERVICE=rmg
RMG_SERVICE_USER=rmg

# The port the app listens on. Also written into the systemd unit for a privileged port, so re-run
# --install if you move it below 1024.
RMG_PORT=5000

# What to listen on: loopback, any, or an IP. Loopback expects a reverse proxy on the VPS itself, and
# is what you want with Caddy in front. "any" answers on every interface, and wants a firewall.
RMG_ADDRESS=loopback

# What the analytics dashboard asks for at /dashboard.html. Leave it out and the dashboard is off,
# though the events are still collected. Make one with: openssl rand -hex 24
# RMG_DASHBOARDTOKEN=

# The reverse proxy, if it is somewhere other than the VPS. One on the VPS is trusted without being
# named; anything else claiming to be a proxy is ignored, which is what stops it forging a client.
# RMG_KNOWNPROXIES=10.0.0.5

# What to publish for. linux-arm64 for an ARM VPS.
RMG_RUNTIME=linux-x64

# How long analytics events are kept. appsettings.json says 180 when this is left out.
# RMG_RETENTIONDAYS=180

# The soundfont the VPS downloads for itself, and the licence that has to travel with it.
RMG_SOUNDFONT_BASE=https://ftp.osuosl.org/pub/musescore/soundfont/MuseScore_General
RMG_SOUNDFONT=MuseScore_General.sf3
RMG_SOUNDFONT_LICENSE=MuseScore_General_License.md
